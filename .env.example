# Copy this file to `.env` for LOCAL development and fill in real values.
# On Render (production) set these as Environment Variables instead — never commit .env.

# Which port the Express server listens on (Render overrides this).
PORT=3000

# Local PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/empire_fashion

# Secret used to sign admin session cookies. Use a long random string.
# GENERATE ONE:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Username for the admin account created on first boot.
# Initial password is always `empire123` — change it in Admin > Settings after first login.
ADMIN_USER=admin

# Monime payment gateway credentials (leave blank to disable card / mobile-money checkout).
MONIME_TOKEN=
MONIME_SPACE=

# Set this on the hosting platform (Render) so cookies are Secure and the proxy is trusted.
# NODE_ENV=production